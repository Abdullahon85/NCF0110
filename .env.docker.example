# Copy to .env next to docker-compose.yml:  cp .env.docker.example .env
# All variables are described in README.md ("Переменные окружения бэкенда").

# --- Required ---
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Public domain(s) of the site, comma-separated, no '*'
ALLOWED_HOSTS=example.uz

# --- Database ---
# PostgreSQL on the same server (outside Docker):
DATABASE_URL=postgres://ncf:PASSWORD@host.docker.internal:5432/ncf
# Built-in test database (docker compose --profile with-db ...):
# DATABASE_URL=postgres://ncf:change-me@db:5432/ncf
# POSTGRES_PASSWORD=change-me

# --- Proxies / HTTPS ---
# Proxies in front of Django that append X-Forwarded-For (needed for per-IP rate limits):
#   1 = only the frontend container's nginx (HTTP_PORT exposed directly)   <- default
#   2 = the server's reverse proxy (nginx/traefik/...) in front + the frontend container
# Too high = clients can spoof their IP and bypass the login limit; too low = all
# visitors share one limit. Verify after deploy (README, "Docker").
TRUSTED_PROXY_COUNT=1
# HTTPS redirect is done by the server's reverse proxy
SECURE_SSL_REDIRECT=False

# --- Images / registry ---
# Registry the images are pushed to / pulled from, e.g. registry.example.uz:5000
REGISTRY=ncf
TAG=latest

# --- Ports on the host ---
# Site + admin panel; also proxies /api and serves /media (point the domain here)
HTTP_PORT=8080
# REST API directly (optional)
API_PORT=8081

# --- Frontend ---
# Empty = same domain /api (recommended). Rebuild the frontend after changing it.
VITE_API_URL=
# Only if the frontend is on a different domain than the API:
CORS_ALLOWED_ORIGINS=
MEDIA_URL=

# --- Optional ---
ENABLE_DJANGO_ADMIN=False
