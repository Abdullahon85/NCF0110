# Copy to .env next to docker-compose.yml:  cp .env.docker.example .env
# All variables are described in README.md ("Docker").

# --- Required ---
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Public domain(s) of the site, comma-separated, no '*'.
# Opening the site by the server IP (http://203.0.113.10:8080) before the domain is set up?
# Add that IP too, otherwise every page answers "400 Bad Request":  ALLOWED_HOSTS=example.uz,203.0.113.10
ALLOWED_HOSTS=example.uz

# --- Database ---
# Nothing to set: SQLite file /data/db.sqlite3 in the "ncf-data" volume.
# Do NOT add DATABASE_URL (PostgreSQL is not used any more; the container refuses to start with it).

# --- Proxies / HTTPS ---
# Proxies in front of the container that append X-Forwarded-For (needed for per-IP rate limits):
#   1 = the server's reverse proxy (nginx/traefik/...) terminates HTTPS and forwards to HTTP_PORT  <- default
#   0 = HTTP_PORT is open to the internet directly, nothing in front
# Too high = clients can spoof their IP and bypass the login limit; too low = all
# visitors share one limit. Verify after deploy (README, "Docker").
TRUSTED_PROXY_COUNT=1
# HTTPS redirect is done by the server's reverse proxy
SECURE_SSL_REDIRECT=False

# --- Images / registry ---
# Registry the image is pushed to / pulled from, e.g. registry.example.uz:5000
REGISTRY=ncf
TAG=latest

# --- Port on the host ---
# Site + admin panel + /api + /media (point the domain / reverse proxy here)
HTTP_PORT=8080

# --- Optional ---
# gunicorn worker processes
WEB_CONCURRENCY=3
ENABLE_DJANGO_ADMIN=False
