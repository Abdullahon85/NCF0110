# Новый ключ: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# True только для локальной разработки/тестов
DEBUG=False
# Через запятую, без '*'
ALLOWED_HOSTS=ncb-1.onrender.com
# Django раздаёт /media/ (картинки товаров)
SERVE_MEDIA=True
# Сколько прокси перед Django добавляют X-Forwarded-For (только для лимита логина; проверить по плану, Task 7 Step 5)
TRUSTED_PROXY_COUNT=1
# Стандартная Django-админка /dashboard-ctrl-panel/ (по умолчанию = DEBUG)
ENABLE_DJANGO_ADMIN=False
